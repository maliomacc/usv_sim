<?xml version="1.0"?>
<!-- Unitree L2 3D LiDAR - Ignition Gazebo Xacro Tanimi -->
<!-- ================================================== -->
<!-- Donanim Parametreleri:                              -->
<!--   Yatay FOV   : 360 derece, 720 ornek              -->
<!--   Dikey FOV   : 96 derece, 96 kanal                -->
<!--   Min Mesafe  : 0.05 m                             -->
<!--   Max Mesafe  : 30.0 m                             -->
<!--   Guncelleme  : 5.55 Hz                            -->
<!--   Gurultu     : Gaussian stddev=0.02 m             -->
<!-- ================================================== -->
<!-- ROS 2 Koprusu (ros_gz_bridge parameter):           -->
<!--   /roboboat/sensors/lidar/pointcloud               -->
<!--   @sensor_msgs/msg/PointCloud2                     -->
<!--   [ignition.msgs.PointCloudPacked                  -->
<!-- ================================================== -->
<!-- GateDetector uyumlulugu icin pointcloud_to_scan:   -->
<!--   ros2 run pointcloud_to_laserscan \               -->
<!--     pointcloud_to_laserscan_node                   -->
<!--     cloud_in => /roboboat/sensors/lidar/pointcloud -->
<!--     scan     => /scan                              -->
<!--     target_frame: unitree_l2_link                  -->
<!-- ================================================== -->

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Fiziksel govde linki -->
  <link name="unitree_l2_link">

    <!-- Gorsel: Ana govde silindiri (cap=69.9mm, yukseklik=81mm) -->
    <visual name="visual_unitree_l2_body">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.081" radius="0.035"/>
      </geometry>
      <material name="unitree_l2_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <!-- Gorsel: Ust kisim doner prizma -->
    <visual name="visual_unitree_l2_top">
      <origin xyz="0.0 0.0 0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.012" radius="0.020"/>
      </geometry>
      <material name="unitree_l2_dark_grey">
        <color rgba="0.25 0.25 0.25 1.0"/>
      </material>
    </visual>

    <!-- Carpismo geometrisi -->
    <collision name="collision_unitree_l2">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.090" radius="0.036"/>
      </geometry>
    </collision>

    <!-- Atalet: Kutup=0.196kg, r=0.035m, h=0.081m -->
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.196"/>
      <inertia
        ixx="0.0001672" ixy="0.0" ixz="0.0"
        iyy="0.0001672" iyz="0.0"
        izz="0.0001201"/>
    </inertial>

  </link>


  <!-- Ignition Gazebo gpu_lidar sensor tanimi -->
  <gazebo reference="unitree_l2_link">

    <sensor name="sensor_unitree_l2" type="gpu_lidar">

      <!-- Ignition topic adi.
           Bu topic uzerine gz_bridge "/points" soneki ekler:
             Ignition taraf: /roboboat/sensors/lidar/pointcloud/points
             ROS 2 taraf   : sensor_msgs/PointCloud2 -->
      <topic>/roboboat/sensors/lidar/pointcloud</topic>

      <!-- TF frame referansi -->
      <gz_frame_id>unitree_l2_link</gz_frame_id>

      <!-- Her zaman aktif -->
      <always_on>true</always_on>

      <!-- Ignition GUI gorsellestime -->
      <visualize>true</visualize>

      <!-- Unitree L2: 5.55 Hz guncelleme hizi -->
      <update_rate>5.55</update_rate>

      <ray>
        <scan>

          <!-- Yatay tarama: 360 derece tam cevre tarama -->
          <!-- 720 beam x 0.5 derece = 360 derece toplam -->
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <!-- -180 derece sol sinir -->
            <min_angle>-3.14159265358979</min_angle>
            <!-- +180 derece sag sinir -->
            <max_angle>3.14159265358979</max_angle>
          </horizontal>

          <!-- Dikey tarama: 96 kanal, simetrik +/-48 derece -->
          <!-- 96 kanal x 1 derece/kanal = 96 derece toplam -->
          <vertical>
            <samples>96</samples>
            <resolution>1</resolution>
            <!-- -48 derece asagi sinir -->
            <min_angle>-0.8377580409572781</min_angle>
            <!-- +48 derece yukari sinir -->
            <max_angle>0.8377580409572781</max_angle>
          </vertical>

        </scan>

        <range>
          <!-- Unitree L2 kor nokta siniri -->
          <min>0.05</min>
          <!-- Unitree L2 maksimum menzil -->
          <max>30.0</max>
          <!-- 1 mm hassasiyet -->
          <resolution>0.001</resolution>
        </range>

        <!-- Gaussian gurultu: Unitree L2 tipik +/- 2 cm hatasi -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>

      </ray>

    </sensor>

  </gazebo>

</robot>