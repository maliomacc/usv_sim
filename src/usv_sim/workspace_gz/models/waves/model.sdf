<?xml version="1.0"?>
<sdf version="1.6">
  <model name="waves">
    <static>true</static>
    <link name="link">
      <visual name="wave_visual">
        <geometry>
          <mesh>
            <uri>model://waves/meshes/waterlow.dae</uri>
          </mesh>
        </geometry>
        <plugin filename="libWaveVisual.so" name="vrx::WaveVisual">
          <shader>
            <vertex>model://waves/materials/programs/GerstnerWaves_vs_330.glsl</vertex>
            <fragment>model://waves/materials/programs/GerstnerWaves_fs_330.glsl</fragment>
            <parameters>
              <rescale>0.6</rescale>
              <bumpScale>200 200</bumpScale>
              <bumpSpeed>0.06 0.03</bumpSpeed>
              <hdrMultiplier>0.8</hdrMultiplier>
              <fresnelPower>5.0</fresnelPower>
              <shallowColor>0.0 0.45 0.65 1.0</shallowColor>
              <deepColor>0.0 0.10 0.30 1.0</deepColor>
            </parameters>
          </shader>
          <wavefield>
            <topic>/vrx/wavefield/parameters</topic>
          </wavefield>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>